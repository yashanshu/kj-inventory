# KJ Inventory - GCE Production Configuration
# Copy this to .env.production and fill in your values

###############################################################################
# Backend Configuration
###############################################################################

# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=15

# Database (SQLite - production path)
DATABASE_DRIVER=sqlite3
DATABASE_URL=file:/app/data/inventory.db?_fk=1
DATABASE_MAX_OPEN_CONN=25
DATABASE_MAX_IDLE_CONN=10

# JWT - CHANGE THIS TO A STRONG SECRET
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_STRING

# CORS - Update with your actual custom domain (the one pointed to Cloudflare)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Logging
LOG_LEVEL=info
SERVE_STATIC=true

# Docker image
DOCKER_IMAGE=ghcr.io/yashanshu/kj-inventory:latest

# Cloudflare Tunnel - get token from Zero Trust > Tunnels > your tunnel
CLOUDFLARE_TUNNEL_TOKEN=

###############################################################################
# Scraper Configuration
###############################################################################

# Swiggy Partner Mobile Number
SWIGGY_MOBILE=

# KJ API Token (generate one from the backend)
KJ_API_TOKEN=

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase (optional)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_FCM_TOKEN=

# Polling
POLL_INTERVAL_MS=30000

# Restaurant Shifts (JSON array, IST 24-hour format)
RESTAURANT_SHIFTS=[{"open":12,"close":15},{"open":19,"close":3}]

TEST_NOTIFICATION_ON_STARTUP=true

# Restaurant ID Mapping (JSON object)
# Example: {"1011965":"Kovilozhiku","1018118":"Bakers Arch"}
RESTAURANT_MAP_JSON={
}

# Menu Fetch (Scraper fetches Swiggy menu daily)
MENU_FETCH_HOUR=18
MENU_RESTAURANT_LAT=28.45293
MENU_RESTAURANT_LNG=77.05048
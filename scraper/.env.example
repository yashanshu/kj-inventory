# Swiggy Partner Credentials
SWIGGY_MOBILE=

# KJ Inventory API
KJ_API_URL=http://localhost:8888/api/v1
KJ_API_TOKEN=

# Notification Toggles (Default: true)
ENABLE_WHATSAPP=false
ENABLE_TELEGRAM=true
ENABLE_FCM=true

# WhatsApp (Unofficial)
# Format: CountryCode + Number (e.g., 919876543210)
WHATSAPP_TO_NUMBER=

# Telegram Notification
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase Cloud Messaging (Android Push)
# Path to Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
FIREBASE_FCM_TOKEN=

# Scraper Settings
# Run browser in headless mode (default: true). Set false to see the browser.
PUPPETEER_HEADLESS=true
# Polling interval in milliseconds (default: 30000 = 30s)
POLL_INTERVAL_MS=30000

# Restaurant Operating Shifts (IST, 24-hour format)
# JSON array of shifts. Overnight shifts supported (e.g., 19-3 = 7PM to 3AM)
# Polling pauses outside these hours to save resources
# Default: [{"open":12,"close":15},{"open":19,"close":3}]
RESTAURANT_SHIFTS=[{"open":12,"close":15},{"open":19,"close":3}]
